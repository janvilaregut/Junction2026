GEMINI_API_KEY=
VERDA_INFERENCE_KEY=
KATSE_GEMINI_FAST=gemini-4-hydrogen
KATSE_GEMINI_REVIEW=gemini-4-carbon
KATSE_THINKING_LEVEL=low
KATSE_VERDA_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
KATSE_VERDA_MODEL=nemotron-3.5-super-vl
KATSE_ENTIRE_PATH=

# Direct structured answers avoid exhausting the output budget in reasoning.
KATSE_VERDA_THINKING=false

# V2 only: auto exempts the pinned PUBLIC Tieto #2283 commit; other inputs are strict.
# Use strict to require local Gemma for every v2 review, including the demo.
KATSE_PRIVACY_MODE=auto
KATSE_GEMMA_URL=http://127.0.0.1:11434
KATSE_GEMMA_MODEL=gemma4:e2b-it-qat
# Comma-separated private names/identifiers, kept local. Never commit real values.
KATSE_PRIVATE_TERMS=
