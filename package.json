{
  "name": "katse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Review by reproduction: verifies agent-written pull requests with executable evidence and routes what is left to a named human.",
  "scripts": {
    "start": "node server/index.js",
